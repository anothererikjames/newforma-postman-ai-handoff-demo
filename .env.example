# --- Postman live sync (optional; demo works fully without these) ---
# When BOTH are set, scripts/sync-postman-workspace.ts switches from dry-run to live mode.
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
# Optional: pin a specific collection UID to update instead of matching by name.
POSTMAN_COLLECTION_ID=

# --- Local API (demo-only values; not secrets) ---
API_PORT=3000
BASE_URL=http://localhost:3000
AUTH_TOKEN=demo-token
